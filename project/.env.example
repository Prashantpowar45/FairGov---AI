# FairGov AI — Environment Variables Template
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your values in .env
# 3. Never commit .env to Git (it is already in .gitignore)
#
# The server loads .env automatically on startup.
# Shell environment variables always take precedence over .env values.

# ── Gemini API ────────────────────────────────────────────────────────────────
# Get your key from: https://aistudio.google.com/app/apikey
# Without this key, /rag/ask and /evaluate (Route B) use retrieval_only mode —
# they return policy evidence but do NOT generate a Gemini answer.
GEMINI_API_KEY=

# Gemini model to use for grounded RAG answers.
GEMINI_MODEL=gemini-3.5-flash-lite
